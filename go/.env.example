# Copy to .env and adjust as needed for local development.
# The agent reads these directly from the environment (see
# internal/config) -- .env is not auto-loaded, so export these or use
# a tool like `direnv`/`dotenv` if you want it sourced automatically.

# TCP port the REST API listens on.
PORT=8080

# Minimum log level: debug | info | warn | error
LOG_LEVEL=info

# Postgres/TimescaleDB connection string. Required -- the agent exits at
# startup if it can't connect. Matches infra/.env.example's TimescaleDB
# credentials for local development.
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/podsentinel?sslmode=disable

# RabbitMQ AMQP URL raw per-pod metrics are published to (metrics.raw).
# Empty disables publishing -- the agent still polls and writes to
# Postgres. Matches infra/.env.example's RabbitMQ credentials for local
# development.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Comma-separated namespace allow-list to poll. Empty means watch all
# namespaces.
WATCH_NAMESPACES=

# How often to poll the Kubernetes APIs.
POLL_INTERVAL=15s

# Origin allowed to make cross-origin requests to the REST API (the
# dashboard's dev/prod origin). Defaults to the Vite dev server's origin.
CORS_ORIGIN=http://localhost:5173
